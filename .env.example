# Reference only: set these environment variables in your shell or MCP host.
# Astra does not automatically read .env files.
ASTRA_WORKSPACE=C:\Users\ryanb\Documents\Codex\AstraVideoStudio\workspace
ASTRA_AE_EXECUTABLE=C:\Program Files\Adobe\Adobe After Effects 2025\Support Files\AfterFX.exe
ASTRA_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
ASTRA_FFPROBE=C:\ffmpeg\bin\ffprobe.exe
# Optional operator-authorized external READ roots, separated by ; on Windows.
# Sources within ASTRA_WORKSPACE do not need an extra root. No .env auto-loading.
# ASTRA_IMPORT_ROOTS=D:\ClientProjects;D:\ApprovedReferences
# Installed AE PNG output-module template name (operator configuration).
# ASTRA_PNG_TEMPLATE=PNG Sequence
# Native result protocol (operator configuration). Default: artifact-v1.
# inline-v1 is the legacy bounded inline payload; never auto-fallback on invalid evidence.
# ASTRA_AE_RESULT_TRANSPORT=artifact-v1

# Final-render ceilings (operator configuration; previews keep their own limits).
# ASTRA_FINAL_MAX_SECONDS=60
# ASTRA_FINAL_MAX_FRAMES=1800
# ASTRA_FINAL_TIMEOUT=900
